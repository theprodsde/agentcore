# Postgres connection string (required)
DATABASE_URL=postgres://agentcore:agentcore@localhost:5432/agentcore

# OpenAI-compatible API key (required for LLM planning and synthesis steps)
# Works with OpenAI, or any compatible endpoint via OPENAI_BASE_URL
OPENAI_API_KEY=

# Override the OpenAI API base URL — set this to use a local model or alternative provider
# OPENAI_BASE_URL=https://api.openai.com/v1

# Slack configuration (optional — only needed for Slack event ingestion)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# URL of an external MCP tool server (optional — falls back to simulated tools if unset)
MCP_SERVER_URL=

# Runbook search API (optional — falls back to contextual simulation if unset)
# RUNBOOK_URL=https://your-confluence-or-wiki-search-endpoint

# Webhook signing secrets (optional — skip verification when unset, REQUIRED in production)
# PAGERDUTY_WEBHOOK_SECRET=your-pagerduty-signing-secret
# OPSGENIE_WEBHOOK_SECRET=your-opsgenie-signing-secret
# ALERTMANAGER_SECRET=your-shared-secret-header-value

# Pino log level: trace | debug | info | warn | error (default: warn)
LOG_LEVEL=warn

# Real tool backends (optional — each falls back to simulation when unset)
# LOKI_URL=http://loki.your-infra.internal:3100
# PROMETHEUS_URL=http://prometheus.your-infra.internal:9090
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_ID=your-team-uuid

# LLM models and limits
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_TIMEOUT_MS=60000

# Tool execution limits
# TOOL_BUDGET_MS=15000        # max total estimated tool time per task
# TOOL_CALL_TIMEOUT_MS=10000  # hard wall-clock cap per MCP tool call

# Rate limiting: max task creations per minute per team/IP/channel (0 disables)
# RATE_LIMIT_RPM=30

# Data retention: purge old rows after N days (unset/0 = keep forever)
# RETENTION_DAYS=90           # tasks + checkpoints (checkpoints hold raw log output)
# MEMORY_RETENTION_DAYS=365   # episodic memories (the learning store)

# Multi-tenancy
# JWT_SECRET=change-me-in-production   # unset = auth disabled (dev mode)
# DEFAULT_TEAM_ID=                     # team that owns Slack/webhook-created tasks
# DISABLE_TEAM_SIGNUP=true             # block POST /api/teams after bootstrap

# OpenTelemetry — set to export traces to Jaeger or any OTLP-compatible backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
