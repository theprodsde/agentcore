# Postgres connection string (required)
DATABASE_URL=postgres://agentcore:agentcore@localhost:5432/agentcore

# OpenAI-compatible API key (required for LLM planning and synthesis steps)
# Works with OpenAI, or any compatible endpoint via OPENAI_BASE_URL
OPENAI_API_KEY=

# Override the OpenAI API base URL — set this to use a local model or alternative provider
# OPENAI_BASE_URL=https://api.openai.com/v1

# Slack configuration (optional — only needed for Slack event ingestion)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# URL of an external MCP tool server (optional — falls back to simulated tools if unset)
MCP_SERVER_URL=

# Pino log level: trace | debug | info | warn | error (default: warn)
LOG_LEVEL=warn

# OpenTelemetry — set to export traces to Jaeger or any OTLP-compatible backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# JWT secret for API auth (Phase 5). Leave unset to disable auth (dev mode)
# JWT_SECRET=change-me-in-production
