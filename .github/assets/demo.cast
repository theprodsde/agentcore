{"version":3,"term":{"cols":80,"rows":24},"timestamp":1790010514,"command":"bash scripts/demo_record.sh","title":"AgentCore — AI incident triage","env":{"SHELL":"/bin/zsh"}}
[0.564, "o", "# AgentCore — AI incident triage in ~30 seconds\r\n\r\n"]
[1.011, "o", "# 1. Trigger an investigation\r\n"]
[0.407, "o", "$ curl -s -X POST localhost:3000/api/tasks \\\r\n"]
[0.000, "o", "    -d '{\"goal\":\"payments-service p99 latency at 4s after deploy\"}' | jq '{task_id,status}'\r\n"]
[0.353, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"task_id\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"2d8f4489-274c-466b-9121-15219c3e0d3b\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"pending\"\u001b[0m\u001b[1;39m\r\n"]
[0.000, "o", "\u001b[1;39m}\u001b[0m\r\n"]
[5.020, "o", "\r\n"]
[0.000, "o", "# 2. Check checkpoint progress (4 steps: recall → plan → tools → synthesize)\r\n"]
[0.446, "o", "$ curl -s localhost:3000/api/tasks/$TASK_ID | jq '{status, steps: (.checkpoints|length)}'\r\n"]
[0.376, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"running\"\u001b[0m\u001b[1;39m,\r\n"]
[0.000, "o", "  \u001b[0m\u001b[1;34m\"steps\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m0\u001b[0m\u001b[1;39m\r\n"]
[0.000, "o", "\u001b[1;39m}\u001b[0m\r\n"]
[3.007, "o", "\r\n# 3. Export the AI-synthesized post-mortem\r\n"]
[0.409, "o", "$ curl -s localhost:3000/api/tasks/$TASK_ID/export.md | head -22\r\n"]
[0.346, "o", "{\"error\":\"Task has no output yet\"}"]
[4.010, "o", "\r\n"]
[0.000, "o", "# 4. Episodic memory — next alert will retrieve this as context\r\n"]
[0.419, "o", "$ curl -s 'localhost:3000/api/memory?q=payments+latency' | jq '.items[0] | {score,outcome}'\r\n"]
[0.344, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"score\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"outcome\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"The payments-service experienced a high p99 latency issue, with the current latency reaching 4230ms, exceeding the SLO threshold of 1000ms. This indicates that the service is underperforming and may affect user transactions.\"\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[3.014, "x", "0"]
